{
  "expo": {
    "name": "Rosso Admin",
    "slug": "rosso-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rosso-admin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C2333"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rossofuoco.admin",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Rosso Admin usa Face ID per autorizzare l'accesso come amministratore senza dover reinserire il PIN.",
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "NSSpeechRecognitionUsageDescription": "Rosso Admin usa il riconoscimento vocale per interpretare i tuoi comandi.",
        "NSMicrophoneUsageDescription": "Rosso Admin usa il microfono per i comandi vocali all'assistente AI.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rossofuoco.admin",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Rosso Admin usa la fotocamera per il riconoscimento del volto dell'amministratore."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Rosso Admin usa il microfono per i comandi vocali all'assistente AI.",
          "speechRecognitionPermission": "Rosso Admin usa il riconoscimento vocale per interpretare i tuoi comandi."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C0392B",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a9691e72-0ef8-4f74-a1bb-973d0a1690ba"
      }
    }
  }
}
