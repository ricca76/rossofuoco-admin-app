{
  "expo": {
    "name": "Rosso Admin",
    "slug": "rosso-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rosso-admin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C2333"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rossofuoco.admin",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Rosso Admin usa Face ID per autorizzare l'accesso come amministratore senza dover reinserire il PIN.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.rossofuoco.admin"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Rosso Admin usa Face ID per autorizzare l'accesso come amministratore senza dover reinserire il PIN."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C0392B",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
